#!/usr/bin/with-contenv bashio
# The line above allows you to use Home Assistant's native bashio library if needed
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: Uptime Kuma
# Sends discovery information to Home Assistant.
# ==============================================================================

bashio::log.info "Configuring runtime certificates..."

# 1. Grab the secret hostname from the Home Assistant UI text box
mapfile -t SERVER_HOSTNAMES < <(bashio::config 'SERVER_HOSTNAMES')

# Check if the user actually filled the string
ALL_HOSTNAMES="${SERVER_HOSTNAMES[*]}"
if [ -z "$ALL_HOSTNAMES" ]; then
    bashio::log.error "Error: 'SERVER_HOSTNAMES' is missing in the add-on Configuration UI!"
    exit 1
else
    bashio::log.info "Server hostname(s) are: $ALL_HOSTNAMES"
fi

bashio::log.info "Configuring certificates for servers: $ALL_HOSTNAMES"
for HOSTNAME in "${SERVER_HOSTNAMES[@]}"; do
    bashio::log.info "Configuring certificates dir for server: $HOSTNAME"
    # Internal paths where your app looks for certificates
    if mkdir -p "$DOCKER_TLS_DIR_PATH"; then
        bashio::log.info "Docker TLS Directory created"
    else
        bashio::log.error "Couldn't create Docker certificate dir"
    fi

    bashio::log.info "Copying certificates into the container for server: $HOSTNAME"
    # Copy or Symlink the files from the secure Home Assistant /ssl share
    if [ -f "/ssl/uptime_kuma/$HOSTNAME/cert.pem" ]; then
        cp -r "/ssl/uptime_kuma/$HOSTNAME" "$DOCKER_TLS_DIR_PATH/"
        ls -al "$DOCKER_TLS_DIR_PATH/$HOSTNAME"
        bashio::log.info "Certificates successfully injected at runtime for host $HOSTNAME"
    else
        bashio::log.warning "Certificates not found in /ssl/ for host $HOSTNAME. Operating without them."
    fi
done


