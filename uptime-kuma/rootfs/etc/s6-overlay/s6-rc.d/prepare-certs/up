#!/usr/bin/with-contenv bashio
# The line above allows you to use Home Assistant's native bashio library if needed

echo "Configuring runtime certificates..."

# 1. Grab the secret hostname from the Home Assistant UI text box
SERVER_HOSTNAME=$(bashio::config 'SERVER_HOSTNAME')

# Check if the user actually filled it out
if [ -z "$SERVER_HOSTNAME" ]; then
    echo "Error: 'SERVER_HOSTNAME' is missing in the add-on Configuration UI!"
    exit 1
fi

echo "Configuring certificates for server: $SERVER_HOSTNAME"

# Internal paths where your app looks for certificates
mkdir -p "$DOCKER_TLS_DIR_PATH/$SERVER_HOSTNAME"

# Copy or Symlink the files from the secure Home Assistant /ssl share
if [ -f "/ssl/uptime_kuma/$SERVER_HOSTNAME/cert.pem" ]; then
    cp -r "/ssl/uptime_kuma/$SERVER_HOSTNAME" "$DOCKER_TLS_DIR_PATH/$SERVER_HOSTNAME"
    echo "Certificates successfully injected at runtime."
else
    echo "Warning: Certificates not found in /ssl/. Operating without them."
fi

